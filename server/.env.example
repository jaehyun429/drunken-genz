# DB — Supabase 프로젝트의 connection string (Settings → Database → URI). 로컬이면 db/apply_local.sh 가 찍어주는 값
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/genz

# Supabase JWT 검증 (Settings → API → JWT Secret). 로컬 개발이면 아무 문자열 + AUTH_DEV_BYPASS=1
SUPABASE_JWT_SECRET=change-me
AUTH_DEV_BYPASS=0            # 1 이면 Authorization: Bearer dev:<user_uuid> 로 로그인 흉내 (로컬 전용)

# 소윤 쪽(DB 웹훅)이 내 서버를 부를 때 쓰는 비밀. 헤더 X-Webhook-Secret
WEBHOOK_SECRET=change-me

# LLM — GPU 서버의 vLLM (OpenAI 호환). 모델 이름은 serve.sh 의 --served-model-name
LLM_BASE_URL=http://localhost:18000/v1
LLM_MODEL=local
LLM_API_KEY=x
LLM_TIMEOUT_S=20             # 평균 2.5초. 넉넉하게
LLM_DISABLE_THINKING=1       # Qwen 류 reasoning 끄기
